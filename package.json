{
  "name": "custombacklog",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo": "tsx scripts/demo.ts",
    "cf:build": "CF_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:migrate": "wrangler d1 migrations apply custombacklog --local",
    "mcp": "tsx mcp/server.ts",
    "api:spec": "tsx scripts/spec.ts",
    "format:check": "prettier --check src tests mcp scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@xyflow/react": "^12.11.6",
    "better-auth": "1.7.5",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
